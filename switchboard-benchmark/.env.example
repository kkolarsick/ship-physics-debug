# Copy to .env and fill in. .env is git-ignored -- never commit real keys.

# --- Firecrawl (hosted extraction baseline) ---
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE=https://api.firecrawl.dev

# --- Browser Use (agentic browser path) ---
BROWSER_USE_API_KEY=
BROWSER_USE_API_BASE=https://api.browser-use.com

# --- Optional additional providers (add adapters before enabling) ---
ZYTE_API_KEY=
BRIGHTDATA_API_KEY=
APIFY_API_TOKEN=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Local compute cost model (see src/pricing.py) ---
# USD per hour attributed to the machine running local engines.
LOCAL_COMPUTE_USD_PER_HOUR=0.06

# --- Safety / politeness (manual section 3) ---
SWITCHBOARD_USER_AGENT=SwitchboardBenchmark/0.2 (+economics benchmark; contact: you@example.com)
SWITCHBOARD_MIN_DOMAIN_DELAY_S=2.0
SWITCHBOARD_MAX_DOMAIN_DELAY_S=5.0
SWITCHBOARD_RESPECT_ROBOTS=1
